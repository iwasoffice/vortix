{
  "manifest_version": 3,
  "name": "Vortix Operations",
  "version": "2.0.0",
  "description": "Monitor Vortix payment operations and launch transactions.",
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "vortix@example.invalid",
      "strict_min_version": "128.0"
    },
    "gecko_android": {}
  },
  "data_collection_permissions": {
    "required": [
      "authenticationInfo",
      "financialAndPaymentInfo"
    ],
    "optional": []
  }
}